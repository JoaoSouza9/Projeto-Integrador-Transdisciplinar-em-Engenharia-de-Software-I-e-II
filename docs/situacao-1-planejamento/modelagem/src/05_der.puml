@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam dpi 130
skinparam linetype ortho
hide circle
skinparam entityBackgroundColor #FFF4E5
skinparam entityBorderColor #8A4B08

entity usuarios {
  * id : SERIAL <<PK>>
  --
  * nome : VARCHAR(100)
  * email : VARCHAR(120) <<UK>>
  * senha_hash : VARCHAR(255)
  telefone : VARCHAR(15)
  * perfil : VARCHAR(10)
  * criado_em : TIMESTAMP
}
entity enderecos {
  * id : SERIAL <<PK>>
  --
  * usuario_id : INTEGER <<FK>>
  * rua, numero, bairro, cidade
  complemento : VARCHAR(60)
  * uf : CHAR(2)
  * cep : CHAR(8)
}
entity categorias {
  * id : SERIAL <<PK>>
  --
  * nome : VARCHAR(50) <<UK>>
}
entity produtos {
  * id : SERIAL <<PK>>
  --
  * categoria_id : INTEGER <<FK>>
  * nome : VARCHAR(80)
  descricao : VARCHAR(300)
  * preco : NUMERIC(10,2)
  * estoque : INTEGER
  imagem_url : VARCHAR(255)
  * ativo : BOOLEAN
}
entity pedidos {
  * id : SERIAL <<PK>>
  --
  * usuario_id : INTEGER <<FK>>
  * endereco_id : INTEGER <<FK>>
  * status : VARCHAR(25)
  * subtotal, frete, total : NUMERIC(10,2)
  observacao : VARCHAR(200)
  * criado_em : TIMESTAMP
}
entity itens_pedido {
  * id : SERIAL <<PK>>
  --
  * pedido_id : INTEGER <<FK>>
  * produto_id : INTEGER <<FK>>
  * quantidade : INTEGER
  * preco_unitario : NUMERIC(10,2)
}
entity pagamentos {
  * id : SERIAL <<PK>>
  --
  * pedido_id : INTEGER <<FK, UK>>
  * forma : VARCHAR(10)
  * status : VARCHAR(10)
  * valor : NUMERIC(10,2)
  * criado_em : TIMESTAMP
}
entity entregas {
  * id : SERIAL <<PK>>
  --
  * pedido_id : INTEGER <<FK, UK>>
  entregador : VARCHAR(80)
  previsao : DATE
  entregue_em : TIMESTAMP
}

usuarios ||--o{ enderecos
usuarios ||--o{ pedidos
enderecos ||--o{ pedidos
categorias ||--o{ produtos
pedidos ||--|{ itens_pedido
produtos ||--o{ itens_pedido
pedidos ||--o| pagamentos
pedidos ||--o| entregas
@enduml
